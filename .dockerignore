# 🐳 Docker忽略文件
# 排除不必要的文件和目录

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建输出
build/
dist/
.next/

# 开发工具
.vscode/
.idea/
*.swp
*.swo

# 环境变量文件（敏感信息）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
logs/
*.log

# 操作系统文件
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker相关
Dockerfile*
docker-compose*
.dockerignore

# 测试覆盖率
coverage/

# 临时文件
tmp/
temp/

# 依赖缓存
.npm/
.yarn/

# ESLint缓存
.eslintcache

# TypeScript缓存
*.tsbuildinfo

# 热重载缓存
.cache/

# Storybook build
storybook-static/

# 文档
README.md
*.md
docs/

# 配置文件（开发用）
.prettierrc
.eslintrc*

# 测试文件
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# 备份文件
*.bak
*.backup
