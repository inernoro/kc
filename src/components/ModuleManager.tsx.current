const ModuleManager: React.FC<ModuleManagerProps> = ({
  currentDepartment,
  onCustomerSelect,
  selectedCustomer,
  customerSuccessMode = 'normal'
}) => {
  const [isTransitioning, setIsTransitioning] = useState(false);
  const [previousDepartment, setPreviousDepartment] = useState<string | null>(null);
  const [selectedDemand, setSelectedDemand] = useState<ProductDemand>(productDemands[0]);
  const [selectedStandard, setSelectedStandard] = useState<TechnicalStandard>(technicalStandards[0]);
  const [previousMode, setPreviousMode] = useState<'normal' | 'assessment'>('normal');
  
  // 青春阳光主题配置
  const sunshineTheme = {
    background: 'bg-gradient-to-br from-orange-50 via-yellow-50 to-pink-50',
    primary: 'from-orange-400 via-yellow-400 to-pink-400',
    secondary: 'from-pink-400 via-rose-400 to-red-400',
    accent: 'from-yellow-300 via-orange-300 to-pink-300',
    cardBg: 'bg-gradient-to-br from-white/80 via-orange-50/30 to-pink-50/50',
    glow: 'shadow-2xl shadow-orange-200/50',
    sparkle: 'animate-pulse'
  };

  // 处理部门切换
  useEffect(() => {
    if (previousDepartment !== currentDepartment) {
      setIsTransitioning(true);
      setPreviousDepartment(currentDepartment);
      
      setTimeout(() => {
        setIsTransitioning(false);
      }, 300);
    }
  }, [currentDepartment, previousDepartment]);

  // 处理考核模式切换
  useEffect(() => {
    if (previousMode !== customerSuccessMode) {
      setPreviousMode(customerSuccessMode);
    }
  }, [customerSuccessMode, previousMode]);

  // 获取当前部门配置
  const getCurrentModules = (): ModuleConfig[] => {
    const departmentConfigs: Record<string, ModuleConfig[]> = {
      '客户成功部': customerSuccessMode === 'assessment' ? [
        {
          id: 'assessment-left',
          name: '考核管理',
          component: AssessmentLeftPanel,
          position: 'left',
          icon: BookOpen,
          color: 'text-orange-600',
          bgColor: 'bg-orange-50/80'
        },
        {
          id: 'assessment-center',
          name: '考核进行状态',
          component: AssessmentCenterPanel,
          position: 'center',
          icon: Target,
          color: 'text-orange-600',
          bgColor: 'bg-orange-50/80'
        },
        {
          id: 'assessment-right',
          name: '能力分析',
          component: AssessmentRightPanel,
          position: 'right',
          icon: TrendingUp,
          color: 'text-orange-600',
          bgColor: 'bg-orange-50/80'
        }
      ] : [
        {
          id: 'customer-list',
          name: '客户列表',
          component: Sidebar,
          position: 'left',
          icon: User,
          color: 'text-blue-600',
          bgColor: 'bg-blue-50/80'
        },
        {
          id: 'chat-area',
          name: '对话区域',
          component: ChatArea,
          position: 'center',
          icon: MessageSquare,
          color: 'text-green-600',
          bgColor: 'bg-green-50/80'
        },
        {
          id: 'customer-panel',
          name: '客户面板',
          component: CustomerPanel,
          position: 'right',
          icon: FileText,
          color: 'text-purple-600',
          bgColor: 'bg-purple-50/80'
        }
      ],
      '品牌域': [
        {
          id: 'demand-pool',
          name: 'TAPD需求池',
          component: DemandPool,
          position: 'left',
          icon: Target,
          color: 'text-green-600',
          bgColor: 'bg-green-50/80'
        },
        {
          id: 'brand-agent-center',
          name: '品牌域智能体中心',
          component: BrandAgentCenter,
          position: 'center',
          icon: Bot,
          color: 'text-purple-600',
          bgColor: 'bg-purple-50/80'
        },
        {
          id: 'version-management',
          name: '版本管理',
          component: VersionManagement,
          position: 'right',
          icon: Crown,
          color: 'text-blue-600',
          bgColor: 'bg-blue-50/80'
        }
      ],
      '产品域': [
        {
          id: 'demand-pool',
          name: 'TAPD需求管理池',
          component: DemandPool,
          position: 'left',
          icon: Target,
          color: 'text-green-600',
          bgColor: 'bg-green-50/80'
        },
        {
          id: 'project-flow',
          name: '产品立项流程',
          component: ProductProjectFlow,
          position: 'center',
          icon: Layers,
          color: 'text-blue-600',
          bgColor: 'bg-blue-50/80'
        },
        {
          id: 'version-management',
          name: '智能版本管理',
          component: VersionManagement,
          position: 'right',
          icon: Crown,
          color: 'text-purple-600',
          bgColor: 'bg-purple-50/80'
        }
      ],
      '基础研发部': [
        {
          id: 'technical-standards',
          name: '技术规范管理库',
          component: TechnicalStandardLibrary,
          position: 'left',
          icon: Code,
          color: 'text-green-600',
          bgColor: 'bg-green-50/80'
        },
        {
          id: 'technical-agent-center',
          name: '技术智能体中心',
          component: TechnicalAgentCenter,
          position: 'center',
          icon: Bot,
          color: 'text-blue-600',
          bgColor: 'bg-blue-50/80'
        },
        {
          id: 'task-tracker',
          name: '任务跟踪管理',
          component: TechnicalTaskTracker,
          position: 'right',
          icon: Activity,
          color: 'text-green-600',
          bgColor: 'bg-green-50/80'
        }
      ]
    };

    return departmentConfigs[currentDepartment] || [];
  };

  const currentModules = getCurrentModules();

  // 获取模块属性
  const getModuleProps = (moduleId: string) => {
    const baseProps = { key: moduleId };
    
    switch (moduleId) {
      case 'customer-list':
        return {
          ...baseProps,
          onCustomerSelect,
          selectedCustomer
        };
      case 'chat-area':
        return {
          ...baseProps,
          selectedCustomer,
          customerSuccessMode
        };
      case 'customer-panel':
        return {
          ...baseProps,
          selectedCustomer,
          customerSuccessMode
        };
      case 'assessment-left':
        return {
          ...baseProps,
          customerSuccessMode
        };
      case 'assessment-center':
        return {
          ...baseProps,
          customerSuccessMode
        };
      case 'assessment-right':
        return {
          ...baseProps,
          customerSuccessMode
        };
      case 'demand-pool':
        return {
          ...baseProps,
          selectedDemand,
          onDemandSelect: setSelectedDemand,
          productDemands
        };
      case 'brand-agent-center':
        return {
          ...baseProps,
          selectedDemand
        };
      case 'project-flow':
        return {
          ...baseProps,
          selectedDemand,
          productProjects
        };
      case 'version-management':
        return {
          ...baseProps,
          selectedDemand,
          productProjects,
          MIDO_PRODUCT_STRUCTURE
        };
      case 'technical-standards':
        return {
          ...baseProps,
          selectedStandard,
          onStandardSelect: setSelectedStandard,
          technicalStandards
        };
      case 'technical-agent-center':
        return {
          ...baseProps,
          selectedStandard
        };
      case 'task-tracker':
        return {
          ...baseProps,
          selectedStandard,
          technicalTasks
        };
      default:
        return baseProps;
    }
  };

  return (
    <div className={`h-full flex transition-all duration-700 ease-in-out ${
      customerSuccessMode === 'assessment' ? sunshineTheme.background : 'bg-gray-50'
    }`}>
      {currentModules.map((module) => {
        const moduleProps = getModuleProps(module.id);
        
        return (
          <div
            key={module.id}
            className={`
              ${module.position === 'left' ? 'w-80' : 
                module.position === 'center' ? 'flex-1 min-w-0' : 'w-80'}
              ${module.position === 'left' ? 'bg-gradient-to-br from-white to-gray-50/30 border-r border-gray-200/60 shadow-sm' :
                module.position === 'center' ? 'bg-gray-50 px-4' : 
                'bg-gradient-to-br from-white to-gray-50/30 border-l border-gray-200/60 shadow-sm'}
              h-full overflow-hidden backdrop-blur-sm
            `}
          >
            <AnimatePresence mode="wait">
              <motion.div
                key={`${module.id}-${currentDepartment}`}
                initial={{ opacity: 0, scale: 0.95, y: 10 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: 0.95, y: -10 }}
                transition={{ 
                  duration: 0.15,
                  ease: [0.25, 0.46, 0.45, 0.94]
                }}
                className="h-full"
              >
                {React.createElement(module.component, moduleProps)}
              </motion.div>
            </AnimatePresence>
          </div>
        );
      })}
    </div>
  );
};

export default ModuleManager;